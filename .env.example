# ─── Granola AI ────────────────────────────────────────────────────────────────
# Generate at: Granola app → Settings → Workspace → API tab
# Requires Business ($14/user/mo) or Enterprise plan
GRANOLA_API_KEY=grn_YOUR_KEY_HERE

# ─── Claude AI ─────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ─── Email delivery (SMTP) ─────────────────────────────────────────────────────
# Who the summary is sent from and to
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# SMTP server settings
# Gmail:   smtp.gmail.com  port 587  (use an App Password, not your real password)
# Outlook: smtp.office365.com  port 587
# iCloud:  smtp.mail.me.com  port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your_app_password_here

# ─── Optional settings ─────────────────────────────────────────────────────────
# How many days back to look for meetings (default: 7)
DAYS_BACK=7

# Set to true to preview the output without sending an email
DRY_RUN=false
