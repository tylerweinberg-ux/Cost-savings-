# Zenoti API Configuration
# Create a backend app at https://app.zenoti.com > Admin > Apps & Integrations
ZENOTI_API_KEY=your_api_key_here

# Optional: JWT authentication (alternative to API key)
# ZENOTI_CLIENT_ID=your_client_id
# ZENOTI_CLIENT_SECRET=your_client_secret

# Zenoti data center base URL — pick the one matching your account region
# US:  https://api.zenoti.com/v1
# AU:  https://api.au.zenoti.com/v1
# UK:  https://api.uk.zenoti.com/v1
# CA:  https://api.ca.zenoti.com/v1
ZENOTI_BASE_URL=https://api.zenoti.com/v1

# Data Warehouse (SQLite by default — swap for postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./zenoti_warehouse.db

# How many records to fetch per page when syncing
SYNC_PAGE_SIZE=100
